<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Hardware corner content padding for fire panel (from DevicesOverlay) -->
    <dimen name="rounded_corner_content_padding">50.0px</dimen>

    <!-- Base start padding of the statusbar (clock side) -->
    <dimen name="status_bar_padding_start">8dp</dimen>

    <!-- Base end padding of the statusbar (system icons side) -->
    <dimen name="status_bar_padding_end">8dp</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">16dp</dimen>

    <!-- Height of the status bar header bar when on Keyguard (syncs with 104.0px punch-hole) -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>

    <!-- Whether usage of the proximity sensor during doze is supported -->
    <bool name="doze_proximity_sensor_supported">false</bool>

    <!-- Doze: check proximity sensor before pulsing? -->
    <bool name="doze_proximity_check_before_pulse">false</bool>

    <!-- Doze: does this device support STATE_DOZE? -->
    <bool name="doze_display_state_supported">true</bool>

    <!-- Whether the display hardware supports always-on display in SystemUI DozeParameters -->
    <bool name="config_dozeSupportsAod">true</bool>

    <!-- Preferred refresh rate at keyguard, if supported by the display. -->
    <integer name="config_keyguardMaxRefreshRate">-1</integer>
</resources>

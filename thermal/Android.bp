cc_binary {
    name: "android.hardware.thermal-service.fire",
    srcs: [
        "main.cpp",
    ],

    vendor: true,
    relative_install_path: "hw",

    init_rc: [
        "android.hardware.thermal-service.fire.rc",
    ],

    vintf_fragments: [
        "android.hardware.thermal-service.fire.xml",
    ],

    shared_libs: [
        "android.hardware.thermal-V2-ndk",
        "libbinder_ndk",
        "liblog",
    ],

    cpp_std: "c++20",

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
